  setName: 
  lines:
  - text: "Barikatlar\u0131 sa\u011Flamla\u015Ft\u0131r\u0131n, bu gece sis \xE7ok
      yo\u011Fun."
    duration: 3.5
    speakerIndex: 0
  - text: "Kul\xFCbedeki cephaneyi kontrol ettin mi?"
    duration: 3
    speakerIndex: 1
  - text: "Her \u015Fey yerinde. G\xF6z\xFCn\xFC yoldan ay\u0131rma yeter."
    duration: 3.5
    speakerIndex: 0
  pauseBetweenLines: 1
